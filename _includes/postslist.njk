<ol reversed class="postlist" style="counter-reset: start-from {{ (postslistCounter or postslist.length) + 1 }}">
{% for post in postslist | reverse %}
	<li class="postlist-item{% if post.url == url %} postlist-item-active{% endif %}" data-vt-post="{{ post.fileSlug }}">
		{% if post.data.thumbnail %}
		<a href="{{ post.url }}">
			{% image post.data.thumbnail, post.data.thumbnailAlt %}
		</a>
		{% endif %}
		<time class="postlist-date" datetime="{{ post.date | htmlDateString }}">{{ post.date | readableDate("LLLL yyyy") }}</time><br>
		<a href="{{ post.url }}" class="postlist-link">
			{% if post.data.title %}
			<h2 data-vt="title">{{ post.data.title }}</h2>
			{% else %}
			<code>{{ post.url }}</code>
			{% endif %}</a>
		{% if post.data.description %}
			<p data-vt="description">{{ post.data.description }}</p>
		{% endif %}
	</li>
{% endfor %}
</ol>
